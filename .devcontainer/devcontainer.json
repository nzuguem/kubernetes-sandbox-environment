{
  "name": "kubernetes-stack",
  "image": "nzuguem/kubernetes-sandbox-environment:latest",
  "mounts": [
    {
      "source": "mise-data-volume",
      "target": "/mnt/mise-data",
      "type": "volume"
    }
  ],
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data",
    "MISE_ENV": "devcontainer",
    "SHELL": "/bin/bash",
    "MISE_GLOBAL_CONFIG_FILE": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/config/tools.toml"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/mnt/mise-data/shims"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-kubernetes-tools.kind-vscode",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint",
        "hverlin.mise-vscode",
        "golang.go",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions"
      ]
    }
  },
  "appPort": [
    80,
    443,
    8180,
    8143,
    8080,
    8443,
    9080,
    9443,
    8088,
    9280,
    5001,
    "127.0.0.1:1080:1080"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/postCreateCommand.sh",
  "postStartCommand": "bash .devcontainer/scripts/postStartCommand.sh",
  "onCreateCommand": "bash .devcontainer/scripts/onCreateCommand.sh"
}
